#!/bin/sh /etc/rc.common
# /etc/init.d/vpnd

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/vpnd

start_service() {
    [ -x "$PROG" ] || return 0
    [ -f /etc/vpn/token ] || return 0

    # Tune nf_conntrack TCP timeouts on every start.
    # TPROXY creates 2 entries per TCP connection; default timeout ~120h causes bloat.
    local ct=/proc/sys/net/netfilter
    [ -f "$ct/nf_conntrack_tcp_timeout_established" ] && {
        echo 300 > "$ct/nf_conntrack_tcp_timeout_established"
        echo 60  > "$ct/nf_conntrack_tcp_timeout_time_wait"
        echo 30  > "$ct/nf_conntrack_tcp_timeout_close_wait"
        echo 10  > "$ct/nf_conntrack_tcp_timeout_fin_wait"
    }

    procd_open_instance vpnd
    # GOMEMLIMIT=10MiB — caps Go heap so GC fires before OOM killer does.
    # procd_set_param env not supported on all OpenWrt versions; use env wrapper.
    procd_set_param command /usr/bin/env GOMEMLIMIT=10485760 "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "vpn"
}
