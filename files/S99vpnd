#!/bin/sh
# Entware init script for vpnd + sing-box on Keenetic
# Place at /opt/etc/init.d/S99vpnd and chmod +x

VPND=/opt/usr/bin/vpnd
SINGBOX_GZ=/opt/usr/share/sing-box.tar.gz
SINGBOX=/tmp/sing-box
VPND_DIR=/opt/etc/vpn
SINGBOX_CFG=/opt/etc/sing-box/config.json
LOGFILE=/tmp/vpnd.log
LOGFILE_MAX_BYTES=5242880  # 5 MB — /tmp is a small tmpfs shared with sing-box's ~60 MB copy

TPROXY_IFACE=br0
REDIR_PORT=7894    # sing-box redirect inbound (TCP, via NAT REDIRECT)
TPROXY_MARK=1      # legacy fwmark (still cleaned up in teardown)
TPROXY_TABLE=100   # legacy routing table (still cleaned up in teardown)

# Traffic exclusions — never tunneled. Prevents two classes of failure:
#   1. Admin lockout: tunneling SSH/Telnet can cut remote access mid-change.
#   2. VPN-in-VPN: a LAN host running its own VPN (WireGuard/WARP) breaks when
#      its encrypted UDP gets re-tunneled; its kill-switch then blocks the host.
EXCLUDE_PORTS="22 23"                      # admin ports (SSH, Telnet)
EXCLUDE_IPS_FILE=/opt/etc/vpn/exclude_ips  # one LAN IPv4 per line -> bypasses tunnel

load_tproxy_modules() {
    insmod /lib/modules/"$(uname -r)"/nf_defrag_ipv4.ko 2>/dev/null
    insmod /lib/modules/"$(uname -r)"/nf_defrag_ipv6.ko 2>/dev/null
    insmod /lib/modules/"$(uname -r)"/xt_socket.ko 2>/dev/null
    insmod /lib/modules/"$(uname -r)"/xt_TPROXY.ko 2>/dev/null
}

# Append RETURN rules so excluded traffic skips interception entirely.
# Must run BEFORE the REDIRECT / TPROXY jump in the chain.
#   $1 = iptables binary (iptables | ip6tables)
#   $2 = table (nat | mangle)
#   $3 = chain name
add_exclusions() {
    _ipt="$1"; _tbl="$2"; _chain="$3"
    for _p in $EXCLUDE_PORTS; do
        $_ipt -t "$_tbl" -A "$_chain" -p tcp --dport "$_p" -j RETURN 2>/dev/null || true
    done
    # Per-device IP excludes are IPv4-only (WARP/secondary-VPN hosts).
    if [ "$_ipt" = "iptables" ] && [ -f "$EXCLUDE_IPS_FILE" ]; then
        while IFS= read -r _ip; do
            case "$_ip" in ''|\#*) continue ;; esac
            iptables -t "$_tbl" -A "$_chain" -s "$_ip" -j RETURN 2>/dev/null || true
        done < "$EXCLUDE_IPS_FILE"
    fi
}

setup_tproxy() {
    # TCP via NAT REDIRECT; QUIC (UDP/443) blocked to force a TCP fallback.
    #
    # The Keenetic kernel forbids TPROXY spoofed-source replies (sendto EPERM), so
    # neither TCP nor UDP can be transparently proxied via TPROXY. REDIRECT (NAT) has
    # no spoofed source and works for TCP. UDP has no NAT-REDIRECT equivalent for
    # transparent proxying, so QUIC can't be tunneled — instead we REJECT UDP/443 so
    # browsers/apps (YouTube, Instagram) instantly fall back to HTTP/2 over TCP, which
    # IS tunneled. IPv6 is not intercepted (tunnel is IPv4-only).

    # Disable Keenetic software fast-path so first packets reach netfilter and
    # establish NAT state instead of being offloaded around it.
    echo 0 > /proc/sys/net/netfilter/nf_conntrack_fastnat 2>/dev/null || true
    echo 0 > /proc/sys/net/netfilter/nf_conntrack_fastnat_xfrm 2>/dev/null || true
    conntrack -F 2>/dev/null || true

    # ── TCP: NAT REDIRECT → redirect-in (7894) ──────────────────────────────
    # REDIRECT runs in nat/PREROUTING; sing-box's own outbound is locally generated
    # (OUTPUT path) so it is never redirected — no self-loop, no mark needed.
    iptables -t nat -N VPNBOT_REDIR 2>/dev/null || iptables -t nat -F VPNBOT_REDIR
    iptables -t nat -A VPNBOT_REDIR -d 10.0.0.0/8 -j RETURN
    iptables -t nat -A VPNBOT_REDIR -d 172.16.0.0/12 -j RETURN
    iptables -t nat -A VPNBOT_REDIR -d 192.168.0.0/16 -j RETURN
    iptables -t nat -A VPNBOT_REDIR -d 127.0.0.0/8 -j RETURN
    add_exclusions iptables nat VPNBOT_REDIR
    iptables -t nat -A VPNBOT_REDIR -p tcp -j REDIRECT --to-ports $REDIR_PORT
    iptables -t nat -A PREROUTING -i $TPROXY_IFACE -p tcp -j VPNBOT_REDIR

    # ── QUIC kill: REJECT UDP/443 so apps fall back to TCP (which is tunneled) ──
    # icmp-port-unreachable triggers an immediate fallback (DROP would force a slow
    # timeout). Skip LAN-to-LAN. Built as a chain so the netfilter.d hook restores it.
    iptables -t filter -N VPNBOT_QUIC 2>/dev/null || iptables -t filter -F VPNBOT_QUIC
    iptables -t filter -A VPNBOT_QUIC -d 10.0.0.0/8 -j RETURN
    iptables -t filter -A VPNBOT_QUIC -d 172.16.0.0/12 -j RETURN
    iptables -t filter -A VPNBOT_QUIC -d 192.168.0.0/16 -j RETURN
    iptables -t filter -A VPNBOT_QUIC -p udp --dport 443 -j REJECT --reject-with icmp-port-unreachable 2>/dev/null \
        || iptables -t filter -A VPNBOT_QUIC -p udp --dport 443 -j DROP
    # Insert at the top of FORWARD so it precedes NDM's conntrack/ACCEPT rules.
    iptables -t filter -I FORWARD 1 -i $TPROXY_IFACE -p udp --dport 443 -j VPNBOT_QUIC

    # MSS clamp — prevents packet drops with Hysteria2 tunnel overhead
    iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
}

teardown_tproxy() {
    echo 1 > /proc/sys/net/netfilter/nf_conntrack_fastnat 2>/dev/null || true
    echo 1 > /proc/sys/net/netfilter/nf_conntrack_fastnat_xfrm 2>/dev/null || true

    # TCP REDIRECT (nat)
    iptables -t nat -D PREROUTING -i $TPROXY_IFACE -p tcp -j VPNBOT_REDIR 2>/dev/null || true
    iptables -t nat -F VPNBOT_REDIR 2>/dev/null || true
    iptables -t nat -X VPNBOT_REDIR 2>/dev/null || true

    # QUIC kill (filter)
    iptables -t filter -D FORWARD -i $TPROXY_IFACE -p udp --dport 443 -j VPNBOT_QUIC 2>/dev/null || true
    iptables -t filter -F VPNBOT_QUIC 2>/dev/null || true
    iptables -t filter -X VPNBOT_QUIC 2>/dev/null || true

    # Legacy UDP TPROXY (mangle) — no longer created, clean up if present
    iptables -t mangle -D PREROUTING -i $TPROXY_IFACE -p udp -j VPNBOT_PREROUTE 2>/dev/null || true
    # Legacy: older versions hooked the chain without -p udp; remove that too.
    iptables -t mangle -D PREROUTING -i $TPROXY_IFACE -j VPNBOT_PREROUTE 2>/dev/null || true
    iptables -t mangle -F VPNBOT_PREROUTE 2>/dev/null || true
    iptables -t mangle -X VPNBOT_PREROUTE 2>/dev/null || true
    iptables -t mangle -F VPNBOT_DIVERT 2>/dev/null || true
    iptables -t mangle -X VPNBOT_DIVERT 2>/dev/null || true
    ip rule del fwmark $TPROXY_MARK table $TPROXY_TABLE 2>/dev/null || true
    ip route del local 0.0.0.0/0 dev lo table $TPROXY_TABLE 2>/dev/null || true

    # Legacy IPv6 interception cleanup (no longer created; tunnel is IPv4-only).
    ip6tables -t mangle -D PREROUTING -i $TPROXY_IFACE -j VPNBOT_PREROUTE6 2>/dev/null || true
    ip6tables -t mangle -F VPNBOT_PREROUTE6 2>/dev/null || true
    ip6tables -t mangle -X VPNBOT_PREROUTE6 2>/dev/null || true
    ip6tables -t mangle -F VPNBOT_DIVERT6 2>/dev/null || true
    ip6tables -t mangle -X VPNBOT_DIVERT6 2>/dev/null || true
    ip -6 rule del fwmark $TPROXY_MARK table $TPROXY_TABLE 2>/dev/null || true
    ip -6 route del local ::/0 dev lo table $TPROXY_TABLE 2>/dev/null || true
}

prepare_singbox() {
    if [ ! -x "$SINGBOX" ]; then
        # Persistent copy at /opt/usr/bin/sing-box (survives reboots)
        if [ -x /opt/usr/bin/sing-box ]; then
            cp /opt/usr/bin/sing-box $SINGBOX && chmod +x $SINGBOX
            echo "$(date) sing-box copied from persistent store" >> $LOGFILE
        elif [ -f "$SINGBOX_GZ" ]; then
            echo "$(date) Unpacking sing-box..." >> $LOGFILE
            cd /tmp && tar xzf "$SINGBOX_GZ" && \
                mv /tmp/sing-box-*/sing-box /tmp/sing-box 2>/dev/null || \
                mv /tmp/sing-box-* /tmp/sing-box 2>/dev/null
            chmod +x $SINGBOX
        else
            echo "$(date) ERROR: no sing-box binary found" >> $LOGFILE
            return 1
        fi
    fi
    return 0
}

# sing-box's own stdout/stderr (one line per proxied connection, including
# every failed direct-outbound dial from LAN P2P traffic) appends to LOGFILE
# forever. No cron is installed to rotate it, so a router left running for
# months fills the tmpfs solid — which then breaks every /tmp-dependent
# operation (OTA downloads, config writes), not just logging. There's no cron
# to schedule a rotation, so piggyback the size check on this hook instead —
# NDM already fires it on every netfilter rebuild, which happens often enough
# in practice (WAN reconnects, DHCP renewals, Wi-Fi changes) to bound growth.
rotate_log_if_oversized() {
    [ -f "$LOGFILE" ] || return 0
    _logsize=$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)
    [ "$_logsize" -gt "$LOGFILE_MAX_BYTES" ] || return 1
    echo "$(date) log ${_logsize}b exceeds ${LOGFILE_MAX_BYTES}b — restarting to reclaim /tmp" >> "$LOGFILE"
    stop
    sleep 1
    # Truncate only after stop(): while vpnd/sing-box still hold LOGFILE open,
    # even `> $LOGFILE` doesn't free tmpfs space until their fds close — the
    # old data stays allocated as a deleted-but-open inode. With both dead,
    # this is a real reset instead of just appending onto the same big file.
    : > "$LOGFILE"
    start
    return 0
}

# Rebuild ONLY the TPROXY iptables rules, without touching sing-box/vpnd —
# unless the log has grown past LOGFILE_MAX_BYTES, in which case a full
# restart runs instead (see rotate_log_if_oversized above).
# Called by the NDM netfilter.d hook after Keenetic rebuilds netfilter.
retproxy() {
    [ -f "$VPND_DIR/token" ] || exit 0
    pgrep -f "$SINGBOX" > /dev/null 2>&1 || exit 0
    rotate_log_if_oversized && return 0
    load_tproxy_modules
    teardown_tproxy
    setup_tproxy
    echo "$(date) TPROXY rules rebuilt (retproxy)" >> $LOGFILE
}

start() {
    echo "$(date) Starting vpnd..." >> $LOGFILE

    # Raise file-descriptor limit: sing-box proxies ALL LAN traffic via TPROXY,
    # each connection costs ~2 FDs and phone QUIC opens them in bursts. The default
    # 1024 exhausts instantly → "accept4: too many open files" → no SYN-ACK to
    # clients (phone hangs) and outbound dials fail. Children inherit this limit.
    # BusyBox ash supports `ulimit -n`; SC3045 only flags strict POSIX sh.
    # shellcheck disable=SC3045
    ulimit -n 51200 2>/dev/null || ulimit -n 8192 2>/dev/null || true

    teardown_tproxy  # clean up stale rules from previous run
    mkdir -p $VPND_DIR /opt/etc/sing-box

    load_tproxy_modules

    if ! prepare_singbox; then
        echo "$(date) Failed to prepare sing-box" >> $LOGFILE
        return 1
    fi

    if [ -f "$SINGBOX_CFG" ]; then
        $SINGBOX run -c $SINGBOX_CFG >> $LOGFILE 2>&1 &
        echo "$(date) sing-box started (pid $!)" >> $LOGFILE
        # Trigger URLTest immediately so Best Latency selects a server without waiting for traffic
        (sleep 8 && curl -sf 'http://127.0.0.1:9090/proxies/Best%20Latency/delay?url=http%3A%2F%2Fwww.gstatic.com%2Fgenerate_204&timeout=8000' >> $LOGFILE 2>&1) &
    else
        echo "$(date) No sing-box config yet — skipping sing-box start" >> $LOGFILE
    fi

    if [ -f "$VPND_DIR/token" ]; then
        setup_tproxy
        $VPND -dir $VPND_DIR >> $LOGFILE 2>&1 &
        echo "$(date) vpnd started (pid $!)" >> $LOGFILE
    else
        echo "$(date) No token yet — run vpn-connect.sh to register" >> $LOGFILE
    fi
}

stop() {
    echo "$(date) Stopping vpnd..." >> $LOGFILE
    teardown_tproxy
    killall vpnd 2>/dev/null || true
    killall sing-box 2>/dev/null || true
}

case "$1" in
    start)    start ;;
    stop)     stop ;;
    restart)  stop; sleep 1; start ;;
    retproxy) retproxy ;;
    *)        echo "Usage: $0 {start|stop|restart|retproxy}"; exit 1 ;;
esac
